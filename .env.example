# SocietySync Environment Configuration

# Server Port (Render sets this automatically to 10000; defaults to 3000 locally)
PORT=3000

# Environment mode
NODE_ENV=production

# JWT signing secret (Required for signing auth tokens; generate a random string)
JWT_SECRET=societysync-super-secret-key-change-in-production-min-32-chars

# Google Gemini API Key for Society AI Assistant
# Get a free key from https://aistudio.google.com
# (Optional: If omitted, the assistant falls back to offline grounded society policy search)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional: Custom database directory path
# On Render with Persistent Disk mounted at /var/data, set:
# DATA_DIR=/var/data
DATA_DIR=
