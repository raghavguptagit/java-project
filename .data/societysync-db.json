    {
      "id": "kb-001",
      "societyId": "soc-green-valley",
      "title": "Clubhouse & Amenity Booking Policy",
      "category": "Facilities",
      "content": "Residents may book the Clubhouse Multipurpose Hall (₹2,500/slot, admin approval required), Indoor Badminton Court (₹200/hr, max 2 hrs/week), and Fitness Studio (free) through the Facilities & Booking module. Cancellations made 24 hours in advance receive a full refund. Quiet hours begin strictly at 10:00 PM.",
      "approved": true,
      "updatedAt": "2026-11-01T00:00:00.000Z"
    },
    {
      "id": "kb-002",
      "societyId": "soc-green-valley",
      "title": "Maintenance Billing & Late Fee Guidelines",
      "category": "Billing",
      "content": "Monthly maintenance bills are issued on the 1st of every month and are due by the 15th. Payments may be submitted via UPI, Bank Transfer (NEFT/IMPS), Cheque, or Cash at the society office. Offline payment references are verified by the Society Admin within 2 business days. A flat late fee of ₹250 applies after the due date. Partial payments are permitted.",
      "approved": true,
      "updatedAt": "2026-11-01T00:00:00.000Z"
    },
    {
      "id": "kb-003",
      "societyId": "soc-green-valley",
      "title": "Visitor & Gate Security Protocol",
      "category": "Security",
      "content": "Residents can pre-approve guests and delivery/service personnel in the Visitors module to generate a single-use invite code (e.g., GVR-XXXXX). Walk-in visitors without an invite code require explicit resident approval from the gate before entry is permitted. All visitors must check out at the gate upon departure.",
      "approved": true,
      "updatedAt": "2026-11-01T00:00:00.000Z"
    },
    {
      "id": "kb-004",
      "societyId": "soc-green-valley",
      "title": "Complaint SLA & Escalation Matrix",
      "category": "Complaints",
      "content": "Service complaints are assigned SLA targets by priority: Urgent (4 hours), High (12 hours), Medium (24 hours), Low (72 hours). Once maintenance staff marks a ticket Resolved, residents have 7 days to confirm closure or reopen the ticket if the issue persists.",
      "approved": true,
      "updatedAt": "2026-11-01T00:00:00.000Z"
    }
  ]
